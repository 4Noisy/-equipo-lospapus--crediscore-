@startuml der
' Render: java -jar plantuml.jar -tpng docs/data/der.puml
!pragma layout smetana
hide circle
hide methods
skinparam shadowing false
skinparam roundCorner 6
skinparam class {
  BackgroundColor #F4F8FD
  BorderColor #2E6295
  ArrowColor #555555
  BackgroundColor<<ref>> #EEEEEE
  BorderColor<<ref>> #888888
  BorderStyle<<ref>> dashed
}

title DER — contexto Scoring & Riesgo Crediticio (Aurora PostgreSQL)

entity "Applicant (ref)" as Applicant <<ref>> {
  * applicant_id : uuid <<PK>>
  --
  * rut_hash : text
  * kyc_status : text
}

entity CreditApplication {
  * application_id : uuid <<PK>>
  --
  * applicant_id : uuid <<FK>>
  * requested_amount : int
  * channel : text
  * status : text
  * submitted_at : timestamptz
}

entity ScoringResult {
  * scoring_id : uuid <<PK>>
  --
  * application_id : uuid <<FK>>
  * score : int
  * risk_category : text
  * model_version : text
  * computed_at : timestamptz
}

entity FinancialProfile {
  * profile_id : uuid <<PK>>
  --
  * application_id : uuid <<FK>>
  * monthly_income : int
  * existing_debt : int
  * employment_type : text
}

entity DecisionRecord {
  * decision_id : uuid <<PK>>
  --
  * application_id : uuid <<FK>>
  * decision : text
  * decided_by : text
  * decided_at : timestamptz
}

entity ManualReview {
  * review_id : uuid <<PK>>
  --
  * decision_id : uuid <<FK>>
  * analyst_id : uuid <<FK>>
  * outcome : text
  notes : text
}

entity "RiskAnalyst (ref)" as RiskAnalyst <<ref>> {
  * analyst_id : uuid <<PK>>
  --
  * name : text
}

Applicant ||--o{ CreditApplication : solicita
CreditApplication ||--o{ ScoringResult : obtiene
CreditApplication ||--|| FinancialProfile : declara
CreditApplication ||--|| DecisionRecord : recibe
DecisionRecord ||--o| ManualReview : se revisa en
RiskAnalyst ||--o{ ManualReview : realiza

note bottom of Applicant
  Applicant y RiskAnalyst son referencias a los
  contextos Identidad / Onboarding.
end note
@enduml
